@model Pricelist
@{
    ViewData["Title"] = Model.Name;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <a href="/Sales/Pricelist" class="text-slate-400 hover:text-slate-600"><i class="fas fa-arrow-@(isRtl ? "right" : "left") text-lg"></i></a>
            <div>
                <h1 class="text-2xl font-bold text-slate-800">@(isRtl && !string.IsNullOrEmpty(Model.NameAr) ? Model.NameAr : Model.Name)</h1>
                @if (Model.Currency != null)
                {
                    <p class="text-slate-500 mt-1"><i class="fas fa-coins"></i> @Model.Currency.Code - @Model.Currency.Name</p>
                }
            </div>
        </div>
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="inline">
            <button type="submit" class="text-red-600 hover:text-red-800 text-sm" onclick="return confirm('@(isRtl ? "هل أنت متأكد؟" : "Are you sure?")')">
                <i class="fas fa-trash"></i> @(isRtl ? "حذف" : "Delete")
            </button>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">@TempData["Success"]</div>
    }

    <!-- Pricing Rules -->
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <div class="px-6 py-4 border-b">
            <h2 class="text-lg font-semibold text-slate-700">@(isRtl ? "قواعد التسعير" : "Pricing Rules") (@Model.Items.Count)</h2>
        </div>
        @if (Model.Items.Any())
        {
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-slate-600">
                    <tr>
                        <th class="px-4 py-3 text-start">@(isRtl ? "المنتج / الفئة" : "Product / Category")</th>
                        <th class="px-4 py-3 text-start">@(isRtl ? "طريقة الحساب" : "Compute Method")</th>
                        <th class="px-4 py-3 text-end">@(isRtl ? "السعر / الخصم" : "Price / Discount")</th>
                        <th class="px-4 py-3 text-end">@(isRtl ? "الحد الأدنى" : "Min Qty")</th>
                        <th class="px-4 py-3 text-start">@(isRtl ? "الصلاحية" : "Validity")</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3">
                                @if (item.Product != null)
                                {
                                    <span class="font-medium">@item.Product.Name</span>
                                }
                                else if (item.Category != null)
                                {
                                    <span class="text-slate-600"><i class="fas fa-folder text-xs"></i> @item.Category.Name</span>
                                }
                                else
                                {
                                    <span class="text-slate-400">@(isRtl ? "الكل" : "All Products")</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-600">@item.ComputeMethod</td>
                            <td class="px-4 py-3 text-end font-medium">
                                @if (item.ComputeMethod == PriceComputeMethod.FixedPrice)
                                {
                                    @item.FixedPrice.ToString("N2")
                                }
                                else if (item.ComputeMethod == PriceComputeMethod.Discount)
                                {
                                    <span>@item.PercentDiscount%</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end">@item.MinQuantity</td>
                            <td class="px-4 py-3 text-sm text-slate-500">
                                @if (item.DateStart.HasValue || item.DateEnd.HasValue)
                                {
                                    @item.DateStart?.ToString("yyyy-MM-dd") <span>-</span> @item.DateEnd?.ToString("yyyy-MM-dd")
                                }
                                else
                                {
                                    <span class="text-slate-400">@(isRtl ? "دائم" : "Always")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-12 text-slate-400">
                <i class="fas fa-list text-3xl mb-3"></i>
                <p>@(isRtl ? "لا توجد قواعد تسعير" : "No pricing rules defined")</p>
            </div>
        }
    </div>
</div>
