@model IEnumerable<Pricelist>
@{
    ViewData["Title"] = "Pricelists";
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">@(isRtl ? "قوائم الأسعار" : "Pricelists")</h1>
            <p class="text-slate-500 mt-1">@(isRtl ? "إدارة قوائم الأسعار وتسعير المنتجات" : "Manage pricelists and product pricing")</p>
        </div>
        <a href="/Sales/Pricelist/Create" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
            <i class="fas fa-plus"></i>
            @(isRtl ? "قائمة جديدة" : "New Pricelist")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">@TempData["Error"]</div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var pl in Model)
        {
            <a href="/Sales/Pricelist/Details/@pl.Id" class="bg-white rounded-xl shadow-sm border p-6 hover:border-green-300 transition">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                        <i class="fas fa-tags text-green-600"></i>
                    </div>
                    @if (pl.IsActive)
                    {
                        <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">@(isRtl ? "نشط" : "Active")</span>
                    }
                </div>
                <h3 class="font-semibold text-slate-800">@(isRtl && !string.IsNullOrEmpty(pl.NameAr) ? pl.NameAr : pl.Name)</h3>
                <p class="text-sm text-slate-500 mt-1">@pl.Items.Count @(isRtl ? "قاعدة تسعير" : "pricing rules")</p>
                @if (pl.Currency != null)
                {
                    <p class="text-xs text-slate-400 mt-1"><i class="fas fa-coins"></i> @pl.Currency.Code</p>
                }
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white rounded-xl shadow-sm border p-12 text-center text-slate-400">
            <i class="fas fa-tags text-4xl mb-3"></i>
            <p>@(isRtl ? "لا توجد قوائم أسعار" : "No pricelists found")</p>
        </div>
    }
</div>
