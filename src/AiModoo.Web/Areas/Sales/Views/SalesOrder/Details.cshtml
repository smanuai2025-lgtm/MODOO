@model SalesOrder
@{
    ViewData["Title"] = Model.Number;
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <a href="/Sales/SalesOrder" class="text-slate-400 hover:text-slate-600"><i class="fas fa-arrow-@(isRtl ? "right" : "left") text-lg"></i></a>
            <div>
                <h1 class="text-2xl font-bold text-slate-800">@Model.Number</h1>
                <p class="text-slate-500 mt-1">
                    @{
                        var sc = Model.Status switch { SalesOrderStatus.Quotation => "amber", SalesOrderStatus.QuotationSent => "blue", SalesOrderStatus.SalesOrder => "emerald", SalesOrderStatus.Done => "slate", SalesOrderStatus.Cancelled => "red", _ => "slate" };
                        var sn = Model.Status switch { SalesOrderStatus.Quotation => isRtl ? "عرض سعر" : "Quotation", SalesOrderStatus.QuotationSent => isRtl ? "مرسل" : "Sent", SalesOrderStatus.SalesOrder => isRtl ? "طلب بيع" : "Sales Order", SalesOrderStatus.Done => isRtl ? "منتهي" : "Done", SalesOrderStatus.Cancelled => isRtl ? "ملغي" : "Cancelled", _ => "" };
                    }
                    <span class="px-3 py-1 rounded-full text-sm bg-@(sc)-100 text-@(sc)-700 font-medium">@sn</span>
                </p>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-2">
            @if (Model.Status == SalesOrderStatus.Quotation || Model.Status == SalesOrderStatus.QuotationSent)
            {
                <form method="post" asp-action="Confirm" asp-route-id="@Model.Id" class="inline">
                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm">
                        <i class="fas fa-check"></i> @(isRtl ? "تأكيد الطلب" : "Confirm Order")
                    </button>
                </form>
            }

            @if (Model.Status == SalesOrderStatus.SalesOrder && !Model.DeliveryPickingId.HasValue)
            {
                <form method="post" asp-action="CreateDelivery" asp-route-id="@Model.Id" class="inline">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
                        <i class="fas fa-truck"></i> @(isRtl ? "إنشاء تسليم" : "Create Delivery")
                    </button>
                </form>
            }

            @if (Model.Status == SalesOrderStatus.SalesOrder && !Model.InvoiceId.HasValue)
            {
                <form method="post" asp-action="CreateInvoice" asp-route-id="@Model.Id" class="inline">
                    <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm">
                        <i class="fas fa-file-invoice"></i> @(isRtl ? "إنشاء فاتورة" : "Create Invoice")
                    </button>
                </form>
            }

            @if (Model.Status != SalesOrderStatus.Done && Model.Status != SalesOrderStatus.Cancelled)
            {
                <form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="inline">
                    <button type="submit" class="bg-red-100 hover:bg-red-200 text-red-700 px-4 py-2 rounded-lg text-sm" onclick="return confirm('@(isRtl ? "هل أنت متأكد من الإلغاء؟" : "Are you sure you want to cancel?")')">
                        <i class="fas fa-times"></i> @(isRtl ? "إلغاء" : "Cancel")
                    </button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">@TempData["Error"]</div>
    }

    <!-- Info Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl shadow-sm border p-6">
            <h2 class="text-lg font-semibold text-slate-700 mb-4"><i class="fas fa-info-circle text-slate-400 me-2"></i>@(isRtl ? "معلومات الطلب" : "Order Info")</h2>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "العميل" : "Customer")</span>
                    <a href="/Sales/Partner/Details/@Model.PartnerId" class="text-blue-600 hover:underline">@(isRtl && !string.IsNullOrEmpty(Model.Partner.NameAr) ? Model.Partner.NameAr : Model.Partner.Name)</a>
                </div>
                <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "تاريخ الطلب" : "Order Date")</span><span>@Model.OrderDate.ToString("yyyy-MM-dd")</span></div>
                @if (Model.ConfirmationDate.HasValue)
                {
                    <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "تاريخ التأكيد" : "Confirmation Date")</span><span>@Model.ConfirmationDate.Value.ToString("yyyy-MM-dd")</span></div>
                }
                @if (Model.ExpirationDate.HasValue)
                {
                    <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "تاريخ الانتهاء" : "Expiration")</span><span>@Model.ExpirationDate.Value.ToString("yyyy-MM-dd")</span></div>
                }
                @if (Model.PaymentTerm != null)
                {
                    <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "شروط الدفع" : "Payment Term")</span><span>@Model.PaymentTerm.Name</span></div>
                }
                @if (Model.Pricelist != null)
                {
                    <div class="flex justify-between"><span class="text-slate-500">@(isRtl ? "قائمة الأسعار" : "Pricelist")</span><span>@Model.Pricelist.Name</span></div>
                }
            </div>
        </div>

        <!-- Linked Docs -->
        <div class="bg-white rounded-xl shadow-sm border p-6">
            <h2 class="text-lg font-semibold text-slate-700 mb-4"><i class="fas fa-link text-slate-400 me-2"></i>@(isRtl ? "المستندات المرتبطة" : "Linked Documents")</h2>
            <div class="space-y-4">
                @if (Model.DeliveryPicking != null)
                {
                    <a href="/Inventory/StockPicking/Details/@Model.DeliveryPickingId" class="flex items-center gap-3 p-3 bg-blue-50 rounded-lg hover:bg-blue-100 transition">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-truck text-blue-600"></i></div>
                        <div>
                            <p class="font-medium text-blue-700">@Model.DeliveryPicking.Name</p>
                            <p class="text-xs text-blue-500">@(isRtl ? "عملية التسليم" : "Delivery Order") - @Model.DeliveryPicking.Status</p>
                        </div>
                    </a>
                }
                else if (Model.Status == SalesOrderStatus.SalesOrder)
                {
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg">
                        <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center"><i class="fas fa-truck text-slate-400"></i></div>
                        <div>
                            <p class="text-slate-500">@(isRtl ? "لم يتم إنشاء التسليم بعد" : "No delivery created yet")</p>
                        </div>
                    </div>
                }

                @if (Model.Invoice != null)
                {
                    <a href="/Accounting/Invoice/Details/@Model.InvoiceId" class="flex items-center gap-3 p-3 bg-purple-50 rounded-lg hover:bg-purple-100 transition">
                        <div class="w-10 h-10 bg-purple-100 rounded-lg flex items-center justify-center"><i class="fas fa-file-invoice text-purple-600"></i></div>
                        <div>
                            <p class="font-medium text-purple-700">@Model.Invoice.Number</p>
                            <p class="text-xs text-purple-500">@(isRtl ? "فاتورة المبيعات" : "Sales Invoice") - @Model.Invoice.Status</p>
                        </div>
                    </a>
                }
                else if (Model.Status == SalesOrderStatus.SalesOrder)
                {
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg">
                        <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center"><i class="fas fa-file-invoice text-slate-400"></i></div>
                        <div>
                            <p class="text-slate-500">@(isRtl ? "لم يتم إنشاء الفاتورة بعد" : "No invoice created yet")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Order Lines -->
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <div class="px-6 py-4 border-b">
            <h2 class="text-lg font-semibold text-slate-700">@(isRtl ? "بنود الطلب" : "Order Lines")</h2>
        </div>
        <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-600">
                <tr>
                    <th class="px-4 py-3 text-start">#</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المنتج" : "Product")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "الكمية" : "Qty")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "مسلم" : "Delivered")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "مفوتر" : "Invoiced")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "سعر الوحدة" : "Unit Price")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "خصم" : "Discount")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "الإجمالي الفرعي" : "Subtotal")</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (var line in Model.Lines.OrderBy(l => l.Sequence))
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3 text-slate-400">@line.Sequence</td>
                        <td class="px-4 py-3">
                            <div class="font-medium">@(isRtl && !string.IsNullOrEmpty(line.DescriptionAr) ? line.DescriptionAr : line.Description)</div>
                            @if (line.Product != null)
                            {
                                <div class="text-xs text-slate-400">@line.Product.InternalReference</div>
                            }
                        </td>
                        <td class="px-4 py-3 text-end">@line.Quantity.ToString("N2")</td>
                        <td class="px-4 py-3 text-end @(line.DeliveredQty >= line.Quantity ? "text-green-600" : "text-orange-600")">@line.DeliveredQty.ToString("N2")</td>
                        <td class="px-4 py-3 text-end @(line.InvoicedQty >= line.Quantity ? "text-green-600" : "text-orange-600")">@line.InvoicedQty.ToString("N2")</td>
                        <td class="px-4 py-3 text-end">@line.UnitPrice.ToString("N2")</td>
                        <td class="px-4 py-3 text-end">@(line.Discount > 0 ? line.Discount.ToString("N1") + "%" : "-")</td>
                        <td class="px-4 py-3 text-end font-medium">@line.SubTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals -->
        <div class="border-t px-6 py-4">
            <div class="flex flex-col items-end gap-2 text-sm">
                <div class="flex gap-8">
                    <span class="text-slate-500">@(isRtl ? "الإجمالي الفرعي" : "Subtotal")</span>
                    <span class="font-medium w-32 text-end">@Model.SubTotal.ToString("N2")</span>
                </div>
                @if (Model.TaxTotal > 0)
                {
                    <div class="flex gap-8">
                        <span class="text-slate-500">@(isRtl ? "الضريبة" : "Tax")</span>
                        <span class="font-medium w-32 text-end">@Model.TaxTotal.ToString("N2")</span>
                    </div>
                }
                <div class="flex gap-8 text-lg border-t pt-2">
                    <span class="font-semibold text-slate-700">@(isRtl ? "الإجمالي" : "Total")</span>
                    <span class="font-bold w-32 text-end text-green-600">@Model.Total.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="bg-white rounded-xl shadow-sm border p-6">
            <h2 class="text-lg font-semibold text-slate-700 mb-2">@(isRtl ? "ملاحظات" : "Notes")</h2>
            <p class="text-sm text-slate-600">@Model.Notes</p>
        </div>
    }
</div>
