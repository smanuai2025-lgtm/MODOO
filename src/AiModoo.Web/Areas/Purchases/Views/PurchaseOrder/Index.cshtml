@model IEnumerable<PurchaseOrder>
@{
    ViewData["Title"] = "Purchase Orders";
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">@(isRtl ? "أوامر الشراء" : "Purchase Orders")</h1>
            <p class="text-slate-500 mt-1">@(isRtl ? "إدارة طلبات عروض الأسعار وأوامر الشراء" : "Manage RFQs and purchase orders")</p>
        </div>
        <a href="/Purchases/PurchaseOrder/Create" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
            <i class="fas fa-plus"></i>
            @(isRtl ? "طلب عرض سعر جديد" : "New RFQ")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">@TempData["Error"]</div>
    }

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
        @{
            var statusGroups = new[] {
                (PurchaseOrderStatus.RFQ, isRtl ? "طلبات عروض" : "RFQs", "amber", "file-alt"),
                (PurchaseOrderStatus.RFQSent, isRtl ? "مرسلة" : "Sent", "blue", "paper-plane"),
                (PurchaseOrderStatus.PurchaseOrder, isRtl ? "أوامر شراء" : "Purchase Orders", "green", "check-circle"),
                (PurchaseOrderStatus.Done, isRtl ? "منتهية" : "Done", "slate", "flag-checkered"),
                (PurchaseOrderStatus.Cancelled, isRtl ? "ملغاة" : "Cancelled", "red", "times-circle")
            };
        }
        @foreach (var (status, label, color, icon) in statusGroups)
        {
            var cnt = Model.Count(o => o.Status == status);
            <a href="/Purchases/PurchaseOrder?status=@((int)status)" class="bg-white rounded-xl shadow-sm border p-4 hover:border-@(color)-300 transition @(ViewBag.CurrentStatus != null && (PurchaseOrderStatus)ViewBag.CurrentStatus == status ? $"border-{color}-400 ring-1 ring-{color}-200" : "")">
                <div class="flex items-center gap-3">
                    <i class="fas fa-@icon text-@(color)-500"></i>
                    <div>
                        <p class="text-xs text-slate-500">@label</p>
                        <p class="text-xl font-bold text-slate-800">@cnt</p>
                    </div>
                </div>
            </a>
        }
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-xl shadow-sm border p-4">
        <form method="get" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-sm text-slate-600 mb-1">@(isRtl ? "البحث" : "Search")</label>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="border rounded-lg px-3 py-2 text-sm w-48" placeholder="@(isRtl ? "رقم أو مورد..." : "Number or vendor...")" />
            </div>
            <div>
                <label class="block text-sm text-slate-600 mb-1">@(isRtl ? "الحالة" : "Status")</label>
                <select name="status" class="border rounded-lg px-3 py-2 text-sm">
                    <option value="">@(isRtl ? "الكل" : "All")</option>
                    @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
                    {
                        <option value="@((int)s)" selected="@(ViewBag.CurrentStatus != null && (int)(PurchaseOrderStatus)ViewBag.CurrentStatus == (int)s)">@s</option>
                    }
                </select>
            </div>
            <button type="submit" class="bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-lg text-sm">
                <i class="fas fa-filter"></i> @(isRtl ? "تصفية" : "Filter")
            </button>
            <a href="/Purchases/PurchaseOrder" class="text-slate-400 hover:text-slate-600 text-sm px-2 py-2">@(isRtl ? "مسح" : "Clear")</a>
        </form>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "الرقم" : "Number")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المورد" : "Vendor")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "التاريخ" : "Date")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الحالة" : "Status")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الاستلام" : "Receipt")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الفاتورة" : "Bill")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "المبلغ" : "Total")</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (var order in Model)
                {
                    <tr class="hover:bg-slate-50 cursor-pointer" onclick="window.location='/Purchases/PurchaseOrder/Details/@order.Id'">
                        <td class="px-4 py-3 font-mono text-orange-600 font-medium">@order.Number</td>
                        <td class="px-4 py-3">@(isRtl && !string.IsNullOrEmpty(order.Vendor?.NameAr) ? order.Vendor.NameAr : order.Vendor?.Name)</td>
                        <td class="px-4 py-3 text-slate-600">@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3 text-center">
                            @{
                                var sc = order.Status switch { PurchaseOrderStatus.RFQ => "amber", PurchaseOrderStatus.RFQSent => "blue", PurchaseOrderStatus.PurchaseOrder => "emerald", PurchaseOrderStatus.Done => "slate", PurchaseOrderStatus.Cancelled => "red", _ => "slate" };
                                var sn = order.Status switch { PurchaseOrderStatus.RFQ => isRtl ? "طلب عرض سعر" : "RFQ", PurchaseOrderStatus.RFQSent => isRtl ? "مرسل" : "Sent", PurchaseOrderStatus.PurchaseOrder => isRtl ? "أمر شراء" : "Purchase Order", PurchaseOrderStatus.Done => isRtl ? "منتهي" : "Done", PurchaseOrderStatus.Cancelled => isRtl ? "ملغي" : "Cancelled", _ => "" };
                            }
                            <span class="px-2 py-1 rounded-full text-xs bg-@(sc)-100 text-@(sc)-700">@sn</span>
                        </td>
                        <td class="px-4 py-3 text-center">
                            @if (order.ReceiptPickingId.HasValue)
                            {
                                <i class="fas fa-dolly text-green-500" title="@(isRtl ? "تم الاستلام" : "Received")"></i>
                            }
                            else
                            {
                                <i class="fas fa-clock text-slate-300"></i>
                            }
                        </td>
                        <td class="px-4 py-3 text-center">
                            @if (order.BillId.HasValue)
                            {
                                <i class="fas fa-file-invoice-dollar text-green-500" title="@(isRtl ? "تم الفوترة" : "Billed")"></i>
                            }
                            else
                            {
                                <i class="fas fa-clock text-slate-300"></i>
                            }
                        </td>
                        <td class="px-4 py-3 text-end font-medium">@order.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-slate-400">
                <i class="fas fa-truck text-4xl mb-3"></i>
                <p>@(isRtl ? "لا توجد أوامر شراء" : "No purchase orders found")</p>
            </div>
        }
    </div>
</div>
