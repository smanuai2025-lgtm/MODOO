@model Payment

@{
    ViewData["Title"] = $"دفعة {Model.Number} | Payment {Model.Number}";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left"></i></a>
            <h1 class="text-2xl font-bold text-gray-800">@Model.Number</h1>
            <span class="px-3 py-1 rounded-full text-sm font-medium
                @(Model.PaymentType == PaymentType.Inbound ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                @Model.PaymentType
            </span>
            <span class="px-3 py-1 rounded-full text-sm font-medium
                @(Model.Status == PaymentStatus.Draft ? "bg-yellow-100 text-yellow-800" :
                  Model.Status == PaymentStatus.Posted ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                @Model.Status
            </span>
        </div>
        <div class="flex gap-2">
            @if (Model.Status == PaymentStatus.Draft)
            {
                <form asp-action="Post" asp-route-id="@Model.Id" method="post" class="inline">
                    <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
                        <i class="fas fa-check me-1"></i> @(isRtl ? "ترحيل" : "Post")
                    </button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="inline" onsubmit="return confirm('@(isRtl ? "هل أنت متأكد؟" : "Are you sure?")')">
                    <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">
                        <i class="fas fa-times me-1"></i> @(isRtl ? "إلغاء" : "Cancel")
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            <div>
                <p class="text-sm text-gray-500 mb-1">@(isRtl ? "التاريخ" : "Date")</p>
                <p class="font-medium">@Model.Date.ToString("yyyy-MM-dd")</p>
            </div>
            <div>
                <p class="text-sm text-gray-500 mb-1">@(isRtl ? "المبلغ" : "Amount")</p>
                <p class="font-bold text-xl text-gray-800">@Model.Amount.ToString("N2")</p>
            </div>
            <div>
                <p class="text-sm text-gray-500 mb-1">@(isRtl ? "طريقة الدفع" : "Payment Method")</p>
                <p class="font-medium">@Model.PaymentMethod?.Name</p>
            </div>
            <div>
                <p class="text-sm text-gray-500 mb-1">@(isRtl ? "اليومية" : "Journal")</p>
                <p class="font-medium">@Model.Journal?.Name</p>
            </div>
            @if (Model.JournalEntryId.HasValue)
            {
                <div>
                    <p class="text-sm text-gray-500 mb-1">@(isRtl ? "القيد المحاسبي" : "Journal Entry")</p>
                    <a asp-controller="JournalEntry" asp-action="Details" asp-route-id="@Model.JournalEntryId" class="text-blue-600 hover:underline">
                        @(isRtl ? "عرض القيد" : "View Entry")
                    </a>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Memo))
            {
                <div class="col-span-full">
                    <p class="text-sm text-gray-500 mb-1">@(isRtl ? "ملاحظات" : "Memo")</p>
                    <p class="text-gray-700">@Model.Memo</p>
                </div>
            }
        </div>
    </div>
</div>
