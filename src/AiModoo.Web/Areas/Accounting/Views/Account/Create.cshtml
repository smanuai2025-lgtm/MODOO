@model Account

@{
    ViewData["Title"] = "حساب جديد | New Account";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 me-3"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "حساب جديد" : "New Account")</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "كود الحساب" : "Account Code") *</label>
                    <input asp-for="Code" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="1001" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "نوع الحساب" : "Account Type") *</label>
                    <select asp-for="AccountType" asp-items="ViewBag.AccountTypes" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="">@(isRtl ? "اختر النوع" : "Select Type")</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الاسم بالإنجليزي" : "English Name") *</label>
                    <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الاسم بالعربي" : "Arabic Name")</label>
                    <input asp-for="NameAr" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" dir="rtl" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الحساب الأب" : "Parent Account")</label>
                    <select asp-for="ParentAccountId" asp-items="ViewBag.ParentAccounts" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="">@(isRtl ? "بدون أب" : "No Parent")</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "العملة" : "Currency")</label>
                    <select asp-for="CurrencyId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        <option value="">@(isRtl ? "العملة الافتراضية" : "Default Currency")</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-6 mb-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsActive" type="checkbox" checked class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">@(isRtl ? "نشط" : "Active")</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="IsReconcilable" type="checkbox" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">@(isRtl ? "قابل للمطابقة" : "Reconcilable")</span>
                </label>
            </div>

            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">@(isRtl ? "إلغاء" : "Cancel")</a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-save me-1"></i> @(isRtl ? "حفظ" : "Save")
                </button>
            </div>
        </form>
    </div>
</div>
