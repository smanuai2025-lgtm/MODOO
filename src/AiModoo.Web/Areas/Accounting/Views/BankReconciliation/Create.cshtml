@model BankReconciliation

@{
    ViewData["Title"] = "مطابقة بنكية جديدة | New Bank Reconciliation";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 me-3"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "مطابقة بنكية جديدة" : "New Bank Reconciliation")</h1>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الحساب البنكي" : "Bank Account") *</label>
                <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="w-full px-3 py-2 border border-gray-300 rounded-lg" required>
                    <option value="">@(isRtl ? "اختر" : "Select")</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "التاريخ" : "Date") *</label>
                <input asp-for="Date" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg" required />
            </div>
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الرصيد الافتتاحي" : "Starting Balance")</label>
                    <input asp-for="StartingBalance" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الرصيد الختامي" : "Ending Balance")</label>
                    <input asp-for="EndingBalance" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg" />
                </div>
            </div>
            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">@(isRtl ? "إلغاء" : "Cancel")</a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"><i class="fas fa-save me-1"></i> @(isRtl ? "حفظ" : "Save")</button>
            </div>
        </form>
    </div>
</div>
