@model TrialBalanceReportDto

@{
    ViewData["Title"] = "ميزان المراجعة | Trial Balance";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "ميزان المراجعة" : "Trial Balance")</h1>
    </div>
    <button onclick="window.print()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200">
        <i class="fas fa-print me-1"></i> @(isRtl ? "طباعة" : "Print")
    </button>
</div>

<!-- Date Filter -->
<form method="get" class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "من تاريخ" : "From Date")</label>
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "إلى تاريخ" : "To Date")</label>
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            <i class="fas fa-filter me-1"></i> @(isRtl ? "تصفية" : "Filter")
        </button>
    </div>
</form>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "كود الحساب" : "Code")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "اسم الحساب" : "Account Name")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "مدين" : "Debit")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "دائن" : "Credit")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "رصيد مدين" : "Debit Balance")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "رصيد دائن" : "Credit Balance")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var line in Model.Lines)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 font-mono text-blue-600">@line.AccountCode</td>
                        <td class="px-4 py-3 font-medium">@(isRtl ? line.AccountNameAr ?? line.AccountName : line.AccountName)</td>
                        <td class="px-4 py-3 text-end font-mono">@line.Debit.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono">@line.Credit.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono text-green-700">@line.DebitBalance.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono text-red-700">@line.CreditBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-gray-100 font-bold">
                <tr>
                    <td colspan="2" class="px-4 py-3 text-end">@(isRtl ? "الإجمالي" : "Total")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.TotalDebit.ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.TotalCredit.ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono text-green-700">@Model.Lines.Sum(l => l.DebitBalance).ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono text-red-700">@Model.Lines.Sum(l => l.CreditBalance).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
