@model TaxReportResult

@{
    ViewData["Title"] = "تقرير الضرائب | Tax Report";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "تقرير الضرائب" : "Tax Report")</h1>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="ExportTaxReportPdf" asp-route-fromDate="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@ViewBag.ToDate?.ToString("yyyy-MM-dd")"
           class="bg-red-50 text-red-700 px-4 py-2 rounded-lg hover:bg-red-100 border border-red-200">
            <i class="fas fa-file-pdf me-1"></i> @(isRtl ? "تصدير PDF" : "Export PDF")
        </a>
        <button onclick="window.print()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200">
            <i class="fas fa-print me-1"></i> @(isRtl ? "طباعة" : "Print")
        </button>
    </div>
</div>

<!-- Date Filter -->
<form method="get" class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "من تاريخ" : "From Date")</label>
            <input type="date" name="fromDate" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "إلى تاريخ" : "To Date")</label>
            <input type="date" name="toDate" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            <i class="fas fa-filter me-1"></i> @(isRtl ? "تصفية" : "Filter")
        </button>
    </div>
</form>

<!-- Tax Lines Table -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "اسم الضريبة" : "Tax Name")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "النوع" : "Type")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "النسبة %" : "Rate %")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "المبلغ الخاضع" : "Taxable Amount")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "مبلغ الضريبة" : "Tax Amount")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model.Lines != null && Model.Lines.Any())
                {
                    @foreach (var line in Model.Lines)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 font-medium">@line.TaxName</td>
                            <td class="px-4 py-3 text-center">
                                @if (line.Type == "Sales")
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        @(isRtl ? "مبيعات" : "Sales")
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                        @(isRtl ? "مشتريات" : "Purchase")
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end font-mono">@line.Rate.ToString("N2")%</td>
                            <td class="px-4 py-3 text-end font-mono">@line.TaxableAmount.ToString("N2")</td>
                            <td class="px-4 py-3 text-end font-mono font-medium">@line.TaxAmount.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-gray-400">
                            <i class="fas fa-inbox text-2xl mb-2"></i>
                            <p>@(isRtl ? "لا توجد بيانات ضريبية للفترة المحددة" : "No tax data for the selected period")</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl shadow-sm border border-green-200 p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
                <i class="fas fa-arrow-up text-green-600"></i>
            </div>
            <p class="text-sm text-gray-500">@(isRtl ? "إجمالي ضريبة المبيعات" : "Total Sales Tax")</p>
        </div>
        <p class="text-2xl font-mono font-bold text-green-700">@Model.TotalSalesTax.ToString("N2")</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-red-200 p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
                <i class="fas fa-arrow-down text-red-600"></i>
            </div>
            <p class="text-sm text-gray-500">@(isRtl ? "إجمالي ضريبة المشتريات" : "Total Purchase Tax")</p>
        </div>
        <p class="text-2xl font-mono font-bold text-red-700">@Model.TotalPurchaseTax.ToString("N2")</p>
    </div>

    <div class="bg-blue-50 rounded-xl shadow-sm border border-blue-200 p-5">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
                <i class="fas fa-balance-scale text-blue-600"></i>
            </div>
            <p class="text-sm text-gray-500">@(isRtl ? "صافي الضريبة المستحقة" : "Net Tax Payable")</p>
        </div>
        <p class="text-2xl font-mono font-bold text-blue-800">@Model.NetTax.ToString("N2")</p>
    </div>
</div>
