@model List<GeneralLedgerDto>

@{
    ViewData["Title"] = "دفتر الأستاذ | General Ledger";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "دفتر الأستاذ" : "General Ledger")</h1>
    </div>
    <button onclick="window.print()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200">
        <i class="fas fa-print me-1"></i> @(isRtl ? "طباعة" : "Print")
    </button>
</div>

<form method="get" class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
    <div class="flex flex-wrap gap-4 items-end">
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "الحساب" : "Account") *</label>
            <input type="number" name="accountId" value="@ViewBag.AccountId" class="px-3 py-2 border border-gray-300 rounded-lg" required />
        </div>
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "من تاريخ" : "From")</label>
            <input type="date" name="fromDate" value="@((ViewBag.FromDate as DateTime?)?.ToString("yyyy-MM-dd"))" class="px-3 py-2 border border-gray-300 rounded-lg" />
        </div>
        <div>
            <label class="block text-sm text-gray-600 mb-1">@(isRtl ? "إلى تاريخ" : "To")</label>
            <input type="date" name="toDate" value="@((ViewBag.ToDate as DateTime?)?.ToString("yyyy-MM-dd"))" class="px-3 py-2 border border-gray-300 rounded-lg" />
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            <i class="fas fa-search me-1"></i> @(isRtl ? "بحث" : "Search")
        </button>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-3 text-start">@(isRtl ? "التاريخ" : "Date")</th>
                        <th class="px-4 py-3 text-start">@(isRtl ? "الرقم" : "Entry")</th>
                        <th class="px-4 py-3 text-start">@(isRtl ? "الوصف" : "Description")</th>
                        <th class="px-4 py-3 text-end">@(isRtl ? "مدين" : "Debit")</th>
                        <th class="px-4 py-3 text-end">@(isRtl ? "دائن" : "Credit")</th>
                        <th class="px-4 py-3 text-end">@(isRtl ? "الرصيد" : "Balance")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var line in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 text-gray-600">@line.Date.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 font-medium text-blue-600">@line.JournalEntryNumber</td>
                            <td class="px-4 py-3 text-gray-700">@line.Label</td>
                            <td class="px-4 py-3 text-end font-mono @(line.Debit > 0 ? "text-green-700" : "text-gray-400")">@line.Debit.ToString("N2")</td>
                            <td class="px-4 py-3 text-end font-mono @(line.Credit > 0 ? "text-red-700" : "text-gray-400")">@line.Credit.ToString("N2")</td>
                            <td class="px-4 py-3 text-end font-mono font-medium @(line.RunningBalance >= 0 ? "text-green-700" : "text-red-700")">@line.RunningBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
