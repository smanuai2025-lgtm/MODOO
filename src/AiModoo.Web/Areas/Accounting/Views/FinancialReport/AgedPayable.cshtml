@model List<AgedBalanceDto>

@{
    ViewData["Title"] = "أعمار الذمم الدائنة | Aged Payable";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "أعمار الذمم الدائنة" : "Aged Payable")</h1>
    </div>
    <button onclick="window.print()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200"><i class="fas fa-print me-1"></i> @(isRtl ? "طباعة" : "Print")</button>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المورد" : "Vendor")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "جاري" : "Current")</th>
                    <th class="px-4 py-3 text-end">31-60</th>
                    <th class="px-4 py-3 text-end">61-90</th>
                    <th class="px-4 py-3 text-end">90+</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "الإجمالي" : "Total")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 font-medium">@item.PartnerName</td>
                        <td class="px-4 py-3 text-end font-mono">@item.Current.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono">@item.Days31To60.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono">@item.Days61To90.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono text-red-600">@item.Over90.ToString("N2")</td>
                        <td class="px-4 py-3 text-end font-mono font-bold">@item.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-gray-100 font-bold">
                <tr>
                    <td class="px-4 py-3">@(isRtl ? "الإجمالي" : "Total")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.Sum(m => m.Current).ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.Sum(m => m.Days31To60).ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.Sum(m => m.Days61To90).ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono text-red-600">@Model.Sum(m => m.Over90).ToString("N2")</td>
                    <td class="px-4 py-3 text-end font-mono">@Model.Sum(m => m.Total).ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
