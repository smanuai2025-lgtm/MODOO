@model IEnumerable<Tax>

@{
    ViewData["Title"] = "الضرائب | Taxes";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "الضرائب" : "Taxes")</h1>
    <a asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
        <i class="fas fa-plus me-1"></i> @(isRtl ? "ضريبة جديدة" : "New Tax")
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-600">
            <tr>
                <th class="px-4 py-3 text-start">@(isRtl ? "الاسم" : "Name")</th>
                <th class="px-4 py-3 text-start">@(isRtl ? "الاسم بالعربي" : "Arabic Name")</th>
                <th class="px-4 py-3 text-center">@(isRtl ? "النوع" : "Type")</th>
                <th class="px-4 py-3 text-end">@(isRtl ? "النسبة/المبلغ" : "Rate/Amount")</th>
                <th class="px-4 py-3 text-center">@(isRtl ? "مضمنة" : "Included")</th>
                <th class="px-4 py-3 text-center">@(isRtl ? "الحالة" : "Status")</th>
                <th class="px-4 py-3 text-center">@(isRtl ? "الإجراءات" : "Actions")</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var tax in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">@tax.Name</td>
                    <td class="px-4 py-3 text-gray-600">@tax.NameAr</td>
                    <td class="px-4 py-3 text-center"><span class="px-2 py-0.5 rounded-full text-xs bg-blue-100 text-blue-800">@tax.Type</span></td>
                    <td class="px-4 py-3 text-end font-mono">@(tax.Type == TaxType.Percentage ? $"{tax.Rate}%" : tax.Rate.ToString("N2"))</td>
                    <td class="px-4 py-3 text-center">@(tax.IncludedInPrice ? "✓" : "-")</td>
                    <td class="px-4 py-3 text-center">
                        <span class="px-2 py-0.5 rounded-full text-xs @(tax.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600")">
                            @(tax.IsActive ? (isRtl ? "نشط" : "Active") : (isRtl ? "غير نشط" : "Inactive"))
                        </span>
                    </td>
                    <td class="px-4 py-3 text-center">
                        <a asp-action="Edit" asp-route-id="@tax.Id" class="text-blue-600 hover:text-blue-800"><i class="fas fa-edit"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
