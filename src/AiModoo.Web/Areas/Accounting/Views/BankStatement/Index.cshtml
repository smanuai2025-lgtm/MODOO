@model IEnumerable<BankStatement>

@{
    ViewData["Title"] = "كشوفات البنك | Bank Statements";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "كشوفات البنك" : "Bank Statements")</h1>
    <div class="flex items-center gap-2">
        <a asp-action="Import" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
            <i class="fas fa-file-import me-1"></i> @(isRtl ? "استيراد" : "Import")
        </a>
        <a asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            <i class="fas fa-plus me-1"></i> @(isRtl ? "كشف جديد" : "New Statement")
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-3 mb-4 flex items-center gap-2">
        <i class="fas fa-check-circle"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-3 mb-4 flex items-center gap-2">
        <i class="fas fa-exclamation-circle"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المرجع" : "Reference")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "الحساب البنكي" : "Bank Account")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "الفترة" : "Period")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "الرصيد الافتتاحي" : "Opening Balance")</th>
                    <th class="px-4 py-3 text-end">@(isRtl ? "الرصيد الختامي" : "Closing Balance")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "عدد البنود" : "Lines")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الحالة" : "Status")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الإجراءات" : "Actions")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (Model != null && Model.Any())
                {
                    @foreach (var statement in Model)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 font-medium text-blue-600">@(statement.Reference ?? "—")</td>
                            <td class="px-4 py-3">@statement.BankAccount?.Name</td>
                            <td class="px-4 py-3 text-gray-600">
                                @statement.PeriodStart.ToString("yyyy-MM-dd") — @statement.PeriodEnd.ToString("yyyy-MM-dd")
                            </td>
                            <td class="px-4 py-3 text-end font-mono">@statement.OpeningBalance.ToString("N2")</td>
                            <td class="px-4 py-3 text-end font-mono">@statement.ClosingBalance.ToString("N2")</td>
                            <td class="px-4 py-3 text-center">
                                <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
                                    @(statement.Lines?.Count ?? 0)
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (statement.IsProcessed)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        @(isRtl ? "معالج" : "Processed")
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                        @(isRtl ? "معلق" : "Pending")
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <a asp-action="Details" asp-route-id="@statement.Id" class="text-blue-600 hover:text-blue-800">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-4 py-8 text-center text-gray-400">
                            <i class="fas fa-inbox text-2xl mb-2"></i>
                            <p>@(isRtl ? "لا توجد كشوفات بنكية" : "No bank statements found")</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
