@model FiscalYear

@{
    ViewData["Title"] = "سنة مالية جديدة | New Fiscal Year";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 me-3"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-800">@(isRtl ? "سنة مالية جديدة" : "New Fiscal Year")</h1>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "الاسم" : "Name") *</label>
                <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="FY 2025" required />
            </div>
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "تاريخ البداية" : "Start Date") *</label>
                    <input asp-for="StartDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" required />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">@(isRtl ? "تاريخ النهاية" : "End Date") *</label>
                    <input asp-for="EndDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" required />
                </div>
            </div>
            <p class="text-sm text-gray-500 mb-6"><i class="fas fa-info-circle me-1"></i> @(isRtl ? "سيتم إنشاء الفترات الشهرية تلقائياً" : "Monthly periods will be generated automatically")</p>
            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">@(isRtl ? "إلغاء" : "Cancel")</a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"><i class="fas fa-save me-1"></i> @(isRtl ? "حفظ" : "Save")</button>
            </div>
        </form>
    </div>
</div>
