@model IEnumerable<PosSession>
@{
    ViewData["Title"] = "POS Sessions";
    var isRtl = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">
                <i class="fas fa-cash-register text-teal-600 mr-2"></i>
                @(isRtl ? "جلسات نقطة البيع" : "POS Sessions")
            </h1>
            <p class="text-slate-500 mt-1">@(isRtl ? "إدارة جلسات نقطة البيع" : "Manage POS Sessions")</p>
        </div>
        <a asp-action="Open" class="bg-teal-600 hover:bg-teal-700 text-white px-5 py-2.5 rounded-xl font-medium transition flex items-center gap-2">
            <i class="fas fa-play"></i>
            @(isRtl ? "فتح جلسة جديدة" : "Open New Session")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl">
            <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "الجلسة" : "Session")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "نقطة البيع" : "POS")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "المستخدم" : "User")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "تاريخ الفتح" : "Opening")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "الحالة" : "Status")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "المبيعات" : "Sales")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "الطلبات" : "Orders")</th>
                    <th class="px-6 py-3 text-center text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "إجراءات" : "Actions")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var session in Model)
                {
                    var statusColor = session.Status switch
                    {
                        PosSessionStatus.Opened => "bg-green-100 text-green-700",
                        PosSessionStatus.Closed => "bg-slate-100 text-slate-700",
                        _ => "bg-yellow-100 text-yellow-700"
                    };
                    var statusText = session.Status switch
                    {
                        PosSessionStatus.Opening => isRtl ? "جاري الفتح" : "Opening",
                        PosSessionStatus.Opened => isRtl ? "مفتوحة" : "Open",
                        PosSessionStatus.Closing => isRtl ? "جاري الإغلاق" : "Closing",
                        PosSessionStatus.Closed => isRtl ? "مغلقة" : "Closed",
                        _ => session.Status.ToString()
                    };
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-6 py-4 font-medium text-slate-800">@session.Name</td>
                        <td class="px-6 py-4 text-slate-600">@session.Config?.Name</td>
                        <td class="px-6 py-4 text-slate-600">@session.UserName</td>
                        <td class="px-6 py-4 text-slate-600">@session.OpeningDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 text-xs font-medium rounded-full @statusColor">@statusText</span>
                        </td>
                        <td class="px-6 py-4 font-medium text-slate-800">@session.TotalSales.ToString("N2")</td>
                        <td class="px-6 py-4 text-slate-600">@session.OrderCount</td>
                        <td class="px-6 py-4 text-center">
                            @if (session.Status == PosSessionStatus.Opened)
                            {
                                <a asp-action="Terminal" asp-route-id="@session.Id"
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-teal-600 text-white rounded-lg text-sm hover:bg-teal-700 transition">
                                    <i class="fas fa-cash-register"></i>
                                    @(isRtl ? "استمرار" : "Continue")
                                </a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@session.Id"
                                   class="inline-flex items-center gap-1 px-3 py-1.5 bg-slate-100 text-slate-600 rounded-lg text-sm hover:bg-slate-200 transition">
                                    <i class="fas fa-eye"></i>
                                    @(isRtl ? "تفاصيل" : "Details")
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-slate-400">
                <i class="fas fa-cash-register text-4xl mb-3"></i>
                <p>@(isRtl ? "لا توجد جلسات بعد" : "No sessions yet")</p>
            </div>
        }
    </div>
</div>
