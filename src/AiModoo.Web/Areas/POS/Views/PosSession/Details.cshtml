@model PosSession
@{
    ViewData["Title"] = "Session Details";
    var isRtl = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">
                <i class="fas fa-cash-register text-teal-600 mr-2"></i>
                @(isRtl ? "تفاصيل الجلسة" : "Session Details") - @Model.Name
            </h1>
            <p class="text-slate-500 mt-1">@Model.Config?.Name</p>
        </div>
        <a asp-action="Index" class="bg-slate-100 hover:bg-slate-200 text-slate-600 px-4 py-2 rounded-xl font-medium transition">
            <i class="fas fa-arrow-left mr-2"></i>@(isRtl ? "العودة" : "Back")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
        </div>
    }

    <!-- Session Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500 mb-1">@(isRtl ? "الحالة" : "Status")</p>
            @{
                var statusColor = Model.Status == PosSessionStatus.Closed ? "bg-slate-100 text-slate-700" : "bg-green-100 text-green-700";
                var statusText = Model.Status == PosSessionStatus.Closed ? (isRtl ? "مغلقة" : "Closed") : (isRtl ? "مفتوحة" : "Open");
            }
            <span class="px-3 py-1 text-sm font-medium rounded-full @statusColor">@statusText</span>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500 mb-1">@(isRtl ? "إجمالي المبيعات" : "Total Sales")</p>
            <p class="text-2xl font-bold text-teal-600">@Model.TotalSales.ToString("N2")</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500 mb-1">@(isRtl ? "عدد الطلبات" : "Orders")</p>
            <p class="text-2xl font-bold text-slate-800">@Model.OrderCount</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
            <p class="text-sm text-slate-500 mb-1">@(isRtl ? "الضريبة" : "Tax")</p>
            <p class="text-2xl font-bold text-slate-800">@Model.TotalTax.ToString("N2")</p>
        </div>
    </div>

    <!-- Session Details -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-semibold text-slate-700 mb-4">@(isRtl ? "معلومات الجلسة" : "Session Info")</h3>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "المستخدم" : "User")</dt>
                    <dd class="font-medium text-slate-700">@Model.UserName</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "تاريخ الفتح" : "Opening Date")</dt>
                    <dd class="font-medium text-slate-700">@Model.OpeningDate.ToString("yyyy-MM-dd HH:mm")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "تاريخ الإغلاق" : "Closing Date")</dt>
                    <dd class="font-medium text-slate-700">@(Model.ClosingDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "الرصيد الافتتاحي" : "Opening Balance")</dt>
                    <dd class="font-medium text-slate-700">@Model.OpeningBalance.ToString("N2")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "الرصيد الختامي" : "Closing Balance")</dt>
                    <dd class="font-medium text-slate-700">@Model.ClosingBalance.ToString("N2")</dd>
                </div>
            </dl>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-6">
            <h3 class="font-semibold text-slate-700 mb-4">@(isRtl ? "ملخص مالي" : "Financial Summary")</h3>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "إجمالي المبيعات" : "Total Sales")</dt>
                    <dd class="font-bold text-teal-600 text-lg">@Model.TotalSales.ToString("N2")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "المرتجعات" : "Returns")</dt>
                    <dd class="font-medium text-red-600">@Model.TotalReturns.ToString("N2")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "الضريبة" : "Tax")</dt>
                    <dd class="font-medium text-slate-700">@Model.TotalTax.ToString("N2")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">@(isRtl ? "الخصومات" : "Discounts")</dt>
                    <dd class="font-medium text-slate-700">@Model.TotalDiscount.ToString("N2")</dd>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="flex justify-between">
                        <dt class="text-slate-500">@(isRtl ? "ملاحظات" : "Notes")</dt>
                        <dd class="font-medium text-slate-700">@Model.Notes</dd>
                    </div>
                }
            </dl>
        </div>
    </div>

    <!-- Orders List -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 bg-slate-50 border-b border-slate-200">
            <h3 class="font-semibold text-slate-700">
                <i class="fas fa-receipt text-teal-600 mr-2"></i>
                @(isRtl ? "الطلبات" : "Orders") (@(Model.Orders?.Count ?? 0))
            </h3>
        </div>
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "رقم الطلب" : "Order #")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "التاريخ" : "Date")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "العميل" : "Customer")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "الأصناف" : "Items")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "الإجمالي" : "Total")</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">@(isRtl ? "طريقة الدفع" : "Payment")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Orders != null)
                {
                    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-6 py-3 font-mono text-sm font-medium text-slate-800">@order.Number</td>
                            <td class="px-6 py-3 text-sm text-slate-600">@order.OrderDate.ToString("HH:mm:ss")</td>
                            <td class="px-6 py-3 text-sm text-slate-600">@(order.PartnerName ?? "-")</td>
                            <td class="px-6 py-3 text-sm text-slate-600">@order.Lines.Count</td>
                            <td class="px-6 py-3 font-medium text-slate-800">@order.Total.ToString("N2")</td>
                            <td class="px-6 py-3 text-sm text-slate-600">
                                @foreach (var p in order.Payments)
                                {
                                    <span class="inline-block bg-teal-50 text-teal-700 text-xs px-2 py-0.5 rounded-full mr-1">
                                        @p.PaymentMethod?.Name: @p.Amount.ToString("N2")
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (Model.Orders == null || !Model.Orders.Any())
        {
            <div class="text-center py-8 text-slate-400">
                <i class="fas fa-receipt text-3xl mb-2"></i>
                <p>@(isRtl ? "لا توجد طلبات" : "No orders")</p>
            </div>
        }
    </div>
</div>
