@{
    ViewData["Title"] = "Open POS Session";
    var isRtl = CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
}

<div class="max-w-lg mx-auto mt-12">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
        <div class="text-center mb-8">
            <div class="w-16 h-16 bg-teal-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-cash-register text-2xl text-teal-600"></i>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">@(isRtl ? "فتح جلسة جديدة" : "Open New Session")</h1>
            <p class="text-slate-500 mt-1">@(isRtl ? "اختر نقطة البيع وأدخل الرصيد الافتتاحي" : "Select POS and enter opening balance")</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
            </div>
        }

        <form asp-action="Open" method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">@(isRtl ? "نقطة البيع" : "POS Terminal")</label>
                    <select name="configId" class="w-full rounded-xl border-slate-300 focus:border-teal-500 focus:ring-teal-500" required>
                        <option value="">@(isRtl ? "اختر..." : "Select...")</option>
                        @if (ViewBag.Configs != null)
                        {
                            @foreach (SelectListItem item in ViewBag.Configs)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">@(isRtl ? "الرصيد الافتتاحي" : "Opening Balance")</label>
                    <input type="number" name="openingBalance" value="0" step="0.01" min="0"
                           class="w-full rounded-xl border-slate-300 focus:border-teal-500 focus:ring-teal-500" />
                </div>

                <div class="flex gap-3 pt-4">
                    <button type="submit" class="flex-1 bg-teal-600 hover:bg-teal-700 text-white py-3 rounded-xl font-medium transition">
                        <i class="fas fa-play mr-2"></i>@(isRtl ? "فتح الجلسة" : "Open Session")
                    </button>
                    <a asp-action="Index" class="px-6 py-3 bg-slate-100 text-slate-600 rounded-xl font-medium hover:bg-slate-200 transition text-center">
                        @(isRtl ? "إلغاء" : "Cancel")
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
