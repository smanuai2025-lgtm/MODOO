@model IReadOnlyList<InventoryAdjustment>
@{
    ViewData["Title"] = "Inventory Adjustments";
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="space-y-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">@(isRtl ? "تسويات الجرد" : "Inventory Adjustments")</h1>
            <p class="text-slate-500 mt-1">@(isRtl ? "الجرد والتسوية المخزنية" : "Physical inventory counts and adjustments")</p>
        </div>
        <a href="/Inventory/InventoryAdjustment/Create" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg flex items-center gap-2">
            <i class="fas fa-plus"></i> @(isRtl ? "تسوية جديدة" : "New Adjustment")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">@TempData["Success"]</div>
    }

    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-600">
                <tr>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المرجع" : "Reference")</th>
                    <th class="px-4 py-3 text-start">@(isRtl ? "المستودع" : "Warehouse")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "عدد المنتجات" : "Products")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "التاريخ" : "Date")</th>
                    <th class="px-4 py-3 text-center">@(isRtl ? "الحالة" : "Status")</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (var adj in Model)
                {
                    var statusColor = adj.Status switch { InventoryAdjustmentStatus.Validated => "green", InventoryAdjustmentStatus.Cancelled => "red", InventoryAdjustmentStatus.InProgress => "blue", _ => "yellow" };
                    var statusText = adj.Status switch { InventoryAdjustmentStatus.Draft => isRtl ? "مسودة" : "Draft", InventoryAdjustmentStatus.InProgress => isRtl ? "قيد الجرد" : "In Progress", InventoryAdjustmentStatus.Validated => isRtl ? "تم" : "Validated", InventoryAdjustmentStatus.Cancelled => isRtl ? "ملغي" : "Cancelled", _ => adj.Status.ToString() };
                    <tr class="hover:bg-slate-50 cursor-pointer" onclick="window.location='/Inventory/InventoryAdjustment/Details/@adj.Id'">
                        <td class="px-4 py-3 font-medium text-purple-600">@adj.Name</td>
                        <td class="px-4 py-3">@(adj.Warehouse?.Name ?? "-")</td>
                        <td class="px-4 py-3 text-center">@(adj.Lines?.Count ?? 0)</td>
                        <td class="px-4 py-3 text-center">@adj.Date.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3 text-center">
                            <span class="px-2 py-1 rounded-full text-xs bg-@(statusColor)-100 text-@(statusColor)-700">@statusText</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-slate-400">
                <i class="fas fa-clipboard-check text-4xl mb-3"></i>
                <p>@(isRtl ? "لا توجد تسويات" : "No adjustments found")</p>
            </div>
        }
    </div>
</div>
