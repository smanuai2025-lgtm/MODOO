@model InventoryAdjustment
@{
    ViewData["Title"] = "New Inventory Adjustment";
    var isRtl = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex items-center gap-4">
        <a href="/Inventory/InventoryAdjustment" class="text-slate-400 hover:text-slate-600"><i class="fas fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-slate-800">@(isRtl ? "تسوية جرد جديدة" : "New Inventory Adjustment")</h1>
    </div>

    <form method="post" asp-action="Create" class="space-y-6">
        @Html.AntiForgeryToken()

        <div class="bg-white rounded-xl shadow-sm border p-6 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">@(isRtl ? "المستودع" : "Warehouse")</label>
                    <select name="WarehouseId" class="w-full border rounded-lg px-3 py-2" asp-items="ViewBag.Warehouses as SelectList">
                        <option value="">@(isRtl ? "-- اختر --" : "-- Select --")</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">@(isRtl ? "الموقع" : "Location")</label>
                    <select name="LocationId" class="w-full border rounded-lg px-3 py-2" asp-items="ViewBag.Locations as SelectList">
                        <option value="">@(isRtl ? "-- اختر --" : "-- Select --")</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">@(isRtl ? "التاريخ" : "Date")</label>
                    <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="w-full border rounded-lg px-3 py-2" />
                </div>
            </div>
        </div>

        <!-- Lines -->
        <div class="bg-white rounded-xl shadow-sm border p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold">@(isRtl ? "سطور الجرد" : "Adjustment Lines")</h2>
                <button type="button" onclick="addAdjLine()" class="bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg text-sm">
                    <i class="fas fa-plus"></i> @(isRtl ? "إضافة سطر" : "Add Line")
                </button>
            </div>
            <table class="w-full text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-3 py-2 text-start">@(isRtl ? "المنتج" : "Product") *</th>
                        <th class="px-3 py-2 text-end" style="width:150px">@(isRtl ? "الكمية النظرية" : "Theoretical Qty")</th>
                        <th class="px-3 py-2 text-end" style="width:150px">@(isRtl ? "الكمية الفعلية" : "Real Qty") *</th>
                        <th class="px-3 py-2" style="width:50px"></th>
                    </tr>
                </thead>
                <tbody id="adjLines">
                    <tr class="border-b">
                        <td class="px-3 py-2">
                            <select name="Lines[0].ProductId" class="w-full border rounded px-2 py-1.5 text-sm" asp-items="ViewBag.Products as SelectList">
                                <option value="0">@(isRtl ? "-- اختر --" : "-- Select --")</option>
                            </select>
                        </td>
                        <td class="px-3 py-2">
                            <input type="number" step="0.01" name="Lines[0].TheoreticalQty" value="0" class="w-full border rounded px-2 py-1.5 text-sm text-end bg-slate-50" readonly />
                        </td>
                        <td class="px-3 py-2">
                            <input type="number" step="0.01" name="Lines[0].RealQty" value="0" class="w-full border rounded px-2 py-1.5 text-sm text-end" />
                        </td>
                        <td class="px-3 py-2 text-center">
                            <button type="button" onclick="this.closest('tr').remove()" class="text-red-400 hover:text-red-600"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg">
                <i class="fas fa-save"></i> @(isRtl ? "حفظ" : "Save")
            </button>
            <a href="/Inventory/InventoryAdjustment" class="bg-slate-100 hover:bg-slate-200 px-6 py-2 rounded-lg">@(isRtl ? "إلغاء" : "Cancel")</a>
        </div>
    </form>
</div>

<script>
    let adjIndex = 1;
    function addAdjLine() {
        const tbody = document.getElementById('adjLines');
        const productOptions = tbody.querySelector('select')?.innerHTML || '<option value="0">-- Select --</option>';
        const tr = document.createElement('tr');
        tr.className = 'border-b';
        tr.innerHTML = `
            <td class="px-3 py-2"><select name="Lines[${adjIndex}].ProductId" class="w-full border rounded px-2 py-1.5 text-sm">${productOptions}</select></td>
            <td class="px-3 py-2"><input type="number" step="0.01" name="Lines[${adjIndex}].TheoreticalQty" value="0" class="w-full border rounded px-2 py-1.5 text-sm text-end bg-slate-50" readonly /></td>
            <td class="px-3 py-2"><input type="number" step="0.01" name="Lines[${adjIndex}].RealQty" value="0" class="w-full border rounded px-2 py-1.5 text-sm text-end" /></td>
            <td class="px-3 py-2 text-center"><button type="button" onclick="this.closest('tr').remove()" class="text-red-400 hover:text-red-600"><i class="fas fa-trash"></i></button></td>
        `;
        tbody.appendChild(tr);
        adjIndex++;
    }
</script>
