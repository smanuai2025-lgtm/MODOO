@{
    ViewData["Title"] = "Coming Soon";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var moduleName = ViewData["ModuleName"]?.ToString() ?? "";
    var moduleNameAr = ViewData["ModuleNameAr"]?.ToString() ?? "";
    var moduleIcon = ViewData["ModuleIcon"]?.ToString() ?? "fas fa-cogs";
    var moduleColor = ViewData["ModuleColor"]?.ToString() ?? "blue";
}

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="text-center max-w-lg">
        <!-- Icon -->
        <div class="w-24 h-24 bg-@(moduleColor)-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="@moduleIcon text-4xl text-@(moduleColor)-500"></i>
        </div>

        <!-- Animation Gears -->
        <div class="flex justify-center gap-2 mb-6">
            <div class="w-3 h-3 bg-@(moduleColor)-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></div>
            <div class="w-3 h-3 bg-@(moduleColor)-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></div>
            <div class="w-3 h-3 bg-@(moduleColor)-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></div>
        </div>

        <!-- Title -->
        <h1 class="text-3xl font-bold text-gray-800 mb-3">
            @(isRtl ? moduleNameAr : moduleName)
        </h1>

        <!-- Message -->
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-6">
            <div class="flex items-center justify-center gap-2 mb-2">
                <i class="fas fa-hard-hat text-amber-500 text-xl"></i>
                <h2 class="text-lg font-semibold text-amber-700">
                    @(isRtl ? "قيد التطوير" : "Under Development")
                </h2>
            </div>
            <p class="text-amber-600">
                @(isRtl 
                    ? "هذه الوحدة قيد التطوير حالياً وستكون متاحة قريباً. نعمل بجد لتوفير أفضل تجربة لك."
                    : "This module is currently under development and will be available soon. We are working hard to provide the best experience for you.")
            </p>
        </div>

        <!-- Progress -->
        <div class="mb-6">
            <div class="flex justify-between text-sm text-gray-500 mb-1">
                <span>@(isRtl ? "التقدم" : "Progress")</span>
                <span>@(isRtl ? "قريباً" : "Coming Soon")</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5">
                <div class="bg-gradient-to-r from-@(moduleColor)-400 to-@(moduleColor)-600 h-2.5 rounded-full" style="width: 15%; animation: progressPulse 2s ease-in-out infinite;"></div>
            </div>
        </div>

        <!-- Back Button -->
        <a href="/Dashboard" class="inline-flex items-center gap-2 bg-@(moduleColor)-600 text-white px-6 py-3 rounded-lg hover:bg-@(moduleColor)-700 transition shadow-lg">
            <i class="fas fa-arrow-@(isRtl ? "right" : "left")"></i>
            @(isRtl ? "العودة للوحة التحكم" : "Back to Dashboard")
        </a>
    </div>
</div>

<style>
    @@keyframes progressPulse {
        0%, 100% { opacity: 1; width: 15%; }
        50% { opacity: 0.7; width: 25%; }
    }
</style>
